# =============================================================================
# E-Magang Kota Madiun — contoh konfigurasi lingkungan
#
# Salin ke .env lalu sesuaikan:
#   cp .env.example .env && php artisan key:generate
#
# Nilai di bawah disusun dari config/*.php. Kunci yang bertanda [PENTING]
# punya jebakan khusus di repo ini — baca komentarnya sebelum mengubah.
# =============================================================================

APP_NAME="E-Magang Kota Madiun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# [PENTING] APP_URL WAJIB memakai skema (http:// atau https://).
# Nilai tanpa skema (mis. "localhost") merusak SELURUH URL yang di-generate
# server — link di email jadi "localhost/localhost/path". phpunit.xml memasang
# APP_URL sendiri justru untuk melindungi test dari kesalahan ini.
APP_URL=http://localhost:8000

# [PENTING] APP_TIMEZONE TIDAK dipakai — config/app.php mengunci 'timezone'
# ke UTC secara hardcoded, karena mengubahnya akan menafsir ulang setiap
# timestamp yang sudah tersimpan di DB. Penjadwalan memakai kunci di bawah.
# Cron harian `magang:transition-statuses` jalan 01:00 pada zona ini.
APP_SCHEDULE_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Basis data — PostgreSQL
#
# [PENTING] Suite test WAJIB punya database PostgreSQL bernama `magang_test`.
# phpunit.xml memasang DB_CONNECTION=pgsql + DB_DATABASE=magang_test tanpa
# fallback SQLite, jadi `php artisan test` mati bila database itu belum ada:
#   createdb magang_test        (atau: psql -c 'create database magang_test')
# Jangan jalankan suite di SQLite — kelas bug CHECK-constraint 2026-07-30
# hanya muncul di PostgreSQL.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=magangdb
DB_USERNAME=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session — driver `database` dibutuhkan fitur sesi tunggal
#
# [PENTING] SESSION_DRIVER harus `database`. Aturan "satu browser tak boleh
# pegang dua akun" mematikan seluruh sesi lain milik user saat ia login
# (trait InvalidatesOtherSessions), dan itu hanya bisa dilakukan bila sesi
# tersimpan di tabel `sessions`.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Queue
#
# [PENTING] Dengan `database`, worker WAJIB jalan atau email tak pernah
# terkirim — `composer dev` sudah menyertakan
# `queue:listen --queue=emails,default`. Semua Job di app/Jobs/ memakai queue
# `emails`. Dengan `sync` job jalan inline: enak untuk dev, tapi kegagalan job
# muncul sebagai error 500 di layar dan TIDAK masuk tabel failed_jobs.
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Mail — Mailpit lokal (UI di http://localhost:8025)
#
# Produksi memakai railsware/mailtrap-php; untuk dev, Mailpit paling praktis:
#   MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025, tanpa kredensial.
# Logo pada email di-embed sebagai CID dari public/images, jadi email tetap
# ter-render walau host di APP_URL sedang mati.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@madiunkota.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Google reCAPTCHA v3 (opsional)
#
# Menjaga form pendaftaran publik, pengiriman OTP, dan login admin. Bila
# RECAPTCHA_SECRET_KEY kosong, App\Rules\Recaptcha melewati verifikasi
# sepenuhnya — dev dan test tanpa kunci tetap jalan. Isi hanya bila domain
# yang dipakai sudah terdaftar di Google, kalau tidak login admin bisa gagal
# bukan karena kredensialnya salah.
# -----------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

VITE_APP_NAME="${APP_NAME}"
